# Copy this file to .env and fill in your own values.
# .env is git-ignored and should NEVER be committed.

# Flask session/JWT signing key — generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# Gmail account used to send alert/reminder emails.
# Use a Gmail "App Password", not your real account password:
# https://myaccount.google.com/apppasswords
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
EMAIL_DISPLAY_NAME=Diabetes Prediction Co
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Local file paths (defaults are usually fine)
DATABASE_PATH=diabetes.db
MODEL_PATH_PRIMARY=diabetes_model.keras
MODEL_PATH_FALLBACK=best_model.keras
PREPROCESSOR_PATH=preprocessor.pkl
DATASET_CSV_PATH=diabetes_prediction_dataset.csv

# Flask run settings
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
